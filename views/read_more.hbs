  <!--content-->

    <div class="container">
    <br/>
	<div class="row justify-content-center">
      <div class="col-12 col-md-10 col-lg-8">
          <form class="card card-sm">
              <div class="row align-items-center">
                  <div class="col-auto">
                      <i class="fas fa-search h4 text-body"></i>
                  </div>
                  <!--end of col-->
                  <div class="col">
                      <input class="form-control form-control-lg form-control-borderless" type="search" placeholder="Search for something..">
                  </div>
                  <!--end of col-->
                  <div class="col-auto">
                      <button class="btn btn-md btn-primary" type="submit">Search</button>
                  </div>
                  <!--end of col-->
              </div>
          </form>
      </div>
      <!--end of col-->
  </div>
</div>


       <div class="row m-auto w-75">

            <div class="col card bg-custom-two m-4">
                <div class="card-header bg-bar text-dark">Categories</div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-sm-6">
                            <ul class="list-unstyled mb-0">
                                <li><a id = "a-sides" href="#!">Web Design</a></li>
                                <li><a id = "a-sides" href="#!">HTML</a></li>
                            </ul>
                        </div>
                        <div class="col-sm-6">
                            <ul class="list-unstyled mb-0">
                                <li><a id = "a-sides" href="#!">JavaScript</a></li>
                                <li><a id = "a-sides" href="#!">CSS</a></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col card bg-custom-two m-4">
                <div class="card-header bg-bar w-100 text-dark">24/7 Expert Support</div>
                <div class="card-body">Our in-house, expert team is always on hand to help answer your questions, get you started, and grow your presence online.
                You can contact us any time!</div>
            </div>
        </div>

  <div class="container bg-custom text-light">
            {{#each article}}

            <div class="row bg-custom-two m-4 p-4">
                <header>
                    <div class="d-flex fit-con flex-row justify-content-between">                    
                      <h2 class="fw-bold my-color m-1">{{this.topic}}</h2> <h5 class="m-1 my-badge p-1 fs-5"><i>{{this.badge}}</i></h5>
                    </div>
                    <div class="text-muted fst-italic ">Posted on: {{this.date}}</div>
                    <a class="badge bg-secondary text-decoration-none link-light m-2" href="#!">{{this.tag}}</a>
                </header>
               <div class="img-div m-auto"><img class="img-responsive" src="../resources/{{this.image}}" alt="">
                </div>
                {{!--  --}}
                <section class="m-2">
                    {{#each this.desc}}
                    <p class="fs-6">{{this}}</p>
                    {{/each}}
                    <h2 class="my-color">{{this.semitopic}}</h2>

                    {{#each this.semidesc}}
                    <p class="fs-6">{{this}}</p>
                    {{/each}}
                </section>
                {{!--  --}}
            </div>

            {{/each}}

 
</div>

<!--  -->
<br>

<section class="mb-5 text-light container p-2">
  <div class="card bg-custom-two">
      <div class="card-body">
          <div class="bg-custom p-2">
            <form class="mb-4"><textarea class="form-control" rows="3" placeholder="Join the discussion and leave a comment!"></textarea></form>
            <button type="submit" class="btn btn-primary" id="btnLogin">Submit</button>
          </div>
          <h2 class="text-dark bg-bar m-4 p-2 fs-4">Comments</h2>


          {{!--  --}}
          {{#each comments}}
          <div class="d-flex mb-4 bg-custom-two p-2 m-1 fit-con">
              <div class="flex-shrink-0"> <img class="rounded-circle" src="../resources/icon1.png" alt=""></div>
              <div class="ms-3">
                  <div class="fw-bold my-color m-1">{{this.name}}</div>
                  {{this.comment}}
                  {{#if this.replies}}
                  {{#each this.replies}}
                    <div class="d-flex mt-4 bg-custom p-2 m-1 align-items-center">
                    <div class="flex-shrink-0"> <img class="rounded-circle" src="../resources/icon2.png" alt=""></div>
                    <div class="ms-3 bg-custom-low p-2 m-1">
                          <div class="fw-bold my-color m-1">{{this.name}}</div>
                          {{this.comment}}</div>
                  </div>
                  {{/each}}
                  {{/if}}

              </div>
          </div>
          {{/each}}
          {{!--  --}}
      </div>
  </div>
</section>